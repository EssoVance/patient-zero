# Solana RPC — public endpoints work, private gives better rate limits
RPC_WS_ENDPOINT=wss://api.mainnet-beta.solana.com
RPC_HTTP_ENDPOINT=https://api.mainnet-beta.solana.com

# Server ports
WS_PORT=8080
REST_PORT=3001

# Scoring thresholds (optional overrides)
ORIGINATOR_THRESHOLD=0.7
MIXED_THRESHOLD=0.4

# Railway deployment (filled in after deploy)
# RAILWAY_BACKEND_URL=wss://your-app.up.railway.app
