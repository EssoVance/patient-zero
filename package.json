{
  "name": "patient-zero",
  "version": "0.1.0",
  "description": "Solana buying-cascade originator discovery network — BIOLUMINESCENCE",
  "scripts": {
    "dev": "ts-node --project tsconfig.json src/index.ts",
    "build": "tsc",
    "build:backend": "tsc",
    "start": "node dist/src/index.js",
    "start:prod": "node dist/src/index.js",
    "frontend": "vite frontend --port 5173",
    "build:frontend": "vite build --config vite.config.ts",
    "test": "jest --testPathPattern=tests",
    "render-gif": "ts-node --project tsconfig.json scripts/renderGif.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run frontend\""
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@types/three": "^0.185.4",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "express": "^4.19.2",
    "gif-encoder-2": "^1.0.5",
    "puppeteer": "^22.12.1",
    "three": "^0.185.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^three$": "<rootDir>/tests/__mocks__/three.ts"
    }
  }
}
